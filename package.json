{
  "name": "macos-desktop",
  "version": "2.1.0",
  "description": "A full-featured independent macOS-style desktop environment simulator built with Electron.",
  "main": "main.js",
  "author": "Joel Engelman",
  "license": "MIT",
  "scripts": {"start":"electron .","dist":"electron-builder --win"},
  "devDependencies": {"electron":"^37.10.3","electron-builder":"^26.15.3"},
  "build": {
    "appId":"com.joelengelman.macosdesktop",
    "productName":"MacOS Desktop",
    "files":["main.js","preload.js","index.html","styles.css","renderer.js"],
    "directories":{"output":"dist"},
    "win":{"target":"nsis"}
  }
}
